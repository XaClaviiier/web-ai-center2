{
  "name": "web-ai-center-server",
  "private": true,
  "description": "Backend API CMS AI Center Ubaya (baca publik + tulis admin) — Bun + Elysia + Drizzle + PostgreSQL (PGlite untuk dev).",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@electric-sql/pglite": "^0.5.8",
    "@elysia/cors": "^1.4.2",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
