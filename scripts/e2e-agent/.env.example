# Salin ke .env (ter-ignore git) lalu isi. Jangan commit nilai asli.
BASE_URL=http://localhost:8080
# Akun Keycloak dev ber-role direktur dan pegawai (lihat keycloak/README.md); password minimal 6 karakter.
KC_USER=uji-direktur
KC_PASS=
KC_USER2=uji-pegawai
KC_PASS2=
# Kunci API Anthropic untuk langkah agen (agent.act / agent.assert). Kosong = tes agen gagal saat langkah agen.
ANTHROPIC_API_KEY=
# Opsional: ganti model Claude (default claude-opus-5-5)
E2E_MODEL=
