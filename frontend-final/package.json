{
  "name": "ubaya-ai-center-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "astro check && tsc -p tsconfig.admin.json --noEmit && astro build && vite build --config vite.admin.config.ts",
    "preview": "bun run scripts/preview.ts",
    "check": "astro check && tsc -p tsconfig.admin.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "astro": "7.4.11",
    "@astrojs/react": "7.1.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@tanstack/react-query": "5.107.1",
    "gsap": "3.15.1",
    "motion": "14.13.0",
    "embla-carousel-react": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0"
  },
  "engines": {
    "node": ">=22.23.4",
    "bun": ">=1.4.4"
  }
}
