---
import type { InferGetStaticPropsType } from 'astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { AlbumDetail } from '../../public/Lists';
import seed from '../../shared/seed.json';

export function getStaticPaths() {
  return seed.dokumentasi
    .filter((d) => d.status === 'posted' && !d.deletedAt)
    .map((d) => ({ params: { slug: d.slug }, props: { slug: d.slug, judul: d.judul, tanggal: d.tanggalPublikasi } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { slug, judul, tanggal } = Astro.props;
---
<PublicLayout title={judul} description={`Dokumentasi kegiatan ${judul} — ${tanggal}`} page="dokumentasi-detail">
  <AlbumDetail client:load slug={slug} />
</PublicLayout>
