---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/tailwind.css';
import '../styles/public.css';
import Navbar from '../public/Navbar.astro';
import { Footer } from '../public/Common';
import SimulationPanel from '../simulation/Panel';

interface Props {
  /** Judul halaman tanpa nama situs; null = hanya nama situs (Beranda). */
  title: string | null;
  description?: string;
  /** Nilai `data-halaman` prototype; dipakai CSS dan behavior.ts. */
  page: string;
  noindex?: boolean;
  /** Panel simulasi; halaman demo tidak memakai API sehingga tanpa panel (prototype T-38). */
  simulation?: boolean;
}

const {
  title,
  description = 'Pusat riset dan layanan kecerdasan artifisial Universitas Surabaya.',
  page,
  noindex = false,
  simulation = true,
} = Astro.props;
const LAYANAN = ['pelatihan', 'inference', 'jejak-alumni', 'perencanaan-implan-gigi', 'document-intelligence'];
const menuAktif = LAYANAN.includes(page) ? 'layanan' : page.replace('-detail', '');
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === null ? 'UBAYA AI Center' : `${title} | UBAYA AI Center`}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex' : 'index'} />
  </head>
  <body data-halaman={page} data-sisi="publik">
    <a class="lewati" href="#utama">Lewati ke konten</a>
    <Navbar aktif={menuAktif} />
    <main id="utama" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {simulation && <SimulationPanel client:load />}
    <script>
      import { mountPublic } from '../public/behavior';

      let lepas = mountPublic();
      window.addEventListener('pagehide', () => lepas());
      window.addEventListener('pageshow', (e) => {
        if (e.persisted) lepas = mountPublic();
      });
    </script>
  </body>
</html>
