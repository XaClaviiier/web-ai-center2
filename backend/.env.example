# Salin ke .env lalu isi. Semua nilai di sini DUMMY.
APP_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# Dipakai hanya untuk pemeriksaan header Origin (CSRF), bukan CORS.
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=false
# Login development (hanya aktif bila APP_ENV=development).
ADMIN_PASSWORD=ganti-dengan-password-dev
DATABASE_URL=postgres://user:password@localhost:5432/ai_center?sslmode=disable
TEST_DATABASE_URL=postgres://user:password@localhost:5432/ai_center_test?sslmode=disable
REDIS_URL=redis://:password@localhost:6379/0
TEST_REDIS_URL=redis://:password@localhost:6379/15
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=dummy-access-key
RUSTFS_SECRET_KEY=dummy-secret-key
RUSTFS_BUCKET=ai-center-images
TEST_RUSTFS_BUCKET=ai-center-test
# Masa berlaku session (security.md §2): idle 1 jam, batas mutlak 8 jam.
SESSION_IDLE_TTL_SECONDS=3600
SESSION_ABSOLUTE_TTL_SECONDS=28800
# Batas request ke endpoint login per IP per menit (security.md §6).
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Batas ukuran satu gambar unggahan, dalam MB (jpg/png/webp; docs: 2 MB).
UPLOAD_MAX_MB=2
# Batas baca publik per IP per menit; hanya dihitung saat cache miss.
RATE_LIMIT_PUBLIC_MISS_PER_MINUTE=300
# Masa hidup cache konten publik di Redis (detik; default 20 menit).
CACHE_TTL_SECONDS=1200
# Batas request admin per user ID per menit; tulis mencakup upload.
RATE_LIMIT_ADMIN_READ_PER_MINUTE=180
RATE_LIMIT_ADMIN_WRITE_PER_MINUTE=30
# Proxy tepercaya (CIDR/IP dipisah koma). Kosong = X-Forwarded-For diabaikan, IP klien = alamat koneksi (RP-03).
TRUSTED_PROXIES=
# Akun admin development kedua (opsional, hanya APP_ENV=development; harus beda dari ADMIN_PASSWORD).
ADMIN_PASSWORD_2=
# Soft lock: masa hidup kunci edit dan interval heartbeat (detik); heartbeat harus lebih kecil dari TTL.
LOCK_TTL_SECONDS=300
LOCK_HEARTBEAT_SECONDS=60
# Folder hasil build Astro (kerangka detail berita/dokumentasi dan 404.html dibaca dari sini).
STATIC_DIR=../web/dist
# Nama situs untuk title, og:site_name, dan JSON-LD.
SITE_NAME=AI Center
# Job berkala (hapus permanen trash kedaluwarsa + pembersihan file yatim). Default: aktif hanya di production.
# Hati-hati: di development job ini menghapus objek yatim di RUSTFS_BUCKET bila diaktifkan.
JOBS_ENABLED=false
# true = hanya mencatat apa yang akan dihapus (disarankan pada hari pertama production).
JOBS_DRY_RUN=false
JOB_INTERVAL_MINUTES=60
JOB_LOCK_TTL_SECONDS=1800
TRASH_RETENTION_DAYS=30
ORPHAN_MIN_AGE_HOURS=24
ORPHAN_MAX_DELETE_PER_RUN=200
