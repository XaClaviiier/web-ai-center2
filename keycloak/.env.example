# Copy to keycloak/.env; paths point to operator-managed files outside git.
# Production: exact HTTPS origins, no trailing slash; callback = backend PUBLIC_BASE_URL + /api/auth/callback.
KEYCLOAK_PUBLIC_ORIGIN=https://identity.example.com
KEYCLOAK_ADMIN_ORIGIN=https://identity-admin.example.com
CMS_CALLBACK_URL=https://ai-center.example.com/api/auth/callback
KEYCLOAK_DB_PASSWORD_FILE=./secrets/db-password.txt
KEYCLOAK_OPERATOR_CONFIG_FILE=./secrets/operator.conf
KEYCLOAK_TLS_CERTIFICATE_FILE=./secrets/identity.crt
KEYCLOAK_TLS_KEY_FILE=./secrets/identity.key
